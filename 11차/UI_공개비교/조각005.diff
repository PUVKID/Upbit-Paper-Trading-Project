+.learning-information{display:grid;grid-template-columns:1.2fr 1fr;gap:14px;padding:0 0 12px}.learning-information>section{min-width:0;padding:16px;background:var(--glass)}.learning-information .learning-now{background:var(--tint)}.learning-information h2{font-size:23px;display:flex;gap:15px;align-items:center;margin-bottom:13px}.learning-information h2::before{content:'';width:5px;height:24px;border-radius:2px;background:var(--muted)}.learning-now h2::before{background:var(--teal)}.learning-information h3{margin-bottom:2px}.learning-information p{font-size:13px;line-height:1.65}.learning-coins{margin:6px 0 11px}.timeframe-row,.classification-row{display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px;align-items:center;padding:12px 0;border-top:1px solid var(--line);font-size:12px}.timeframes{display:flex;align-items:center;flex-wrap:wrap;gap:5px}.timeframes span{font-size:11px;padding:6px 7px;border:1px solid var(--line);background:var(--glass);border-radius:4px;white-space:nowrap}.class-swatches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.class-swatches>div{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;padding:12px 5px 10px;border-radius:6px;min-width:0;background:var(--down-tint)}.class-swatches>.flat{background:var(--flat-tint)}.class-swatches>.up{background:var(--tint-strong)}.class-swatches small{width:100%;text-align:center;font-size:10px;color:var(--muted);line-height:1.6}.class-swatches b{font-size:14px}.class-swatches svg{width:18px;height:18px}
+.experiment-summary{margin-top:12px}.experiment-summary>div{display:grid;grid-template-columns:100px minmax(0,1fr);border-bottom:1px solid var(--line);font-size:13px;line-height:1.6}.experiment-summary dt{padding:10px 10px 10px 0;display:flex;align-items:center}.experiment-summary dd{margin:0;padding:10px 0 10px 12px;border-left:1px solid var(--line);overflow-wrap:anywhere;color:var(--muted)}.learning-information .details{grid-template-columns:repeat(2,minmax(0,1fr))}.learning-recent>.raw-details{margin-top:10px}.learning-recent>.raw-details>summary{color:var(--ink)}
+.workflow-caption{font-size:11px;line-height:1.6;color:var(--muted);margin:0 0 10px}
+@media(prefers-reduced-motion:no-preference){button,.tabs button{transition:background .18s,color .18s}.view{animation:appear .2s ease-out}@keyframes appear{from{opacity:.7}to{opacity:1}}}.motion-paused *{animation:none!important;transition:none!important}
+@media(max-width:1150px){.sidebar{width:150px}.tabs button{padding:12px;gap:12px;font-size:16px}main{margin-left:150px;padding:20px}.heading{gap:12px;margin-bottom:24px}.header-tools{gap:6px}.auto{font-size:10px}.tag{font-size:11px;padding:7px 9px}.overview{grid-template-columns:1.15fr 1fr .85fr;gap:18px}.balance{font-size:30px}.allocation,.current-status{padding-left:16px}.allocation-content{grid-template-columns:1fr}.allocation-legend{display:flex;gap:18px;justify-content:center}.allocation-legend>div{margin:0;gap:8px}.allocation-legend dd{font-size:14px}#allocation-stage{height:155px}.status-copy{gap:7px}.status-copy strong{font-size:19px}.coin-headings{padding:0;gap:5px}.coin-heading{gap:7px}.coin-heading img{width:27px;height:27px}.coin-heading b{font-size:12px}.market-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.details{grid-template-columns:repeat(3,minmax(0,1fr))}.training-overview{grid-template-columns:24px 1fr minmax(80px,160px) auto;gap:11px}.services{grid-template-columns:repeat(2,minmax(0,1fr))}.learning-strip>div{padding:4px 9px;grid-template-columns:1fr;gap:5px}.learning-strip svg{display:none}.learning-strip dd{grid-column:1;font-size:18px}.workflow-steps li{padding:0 7px}.workflow-steps b{font-size:13px}.workflow-steps span{font-size:11px}.learning-information{gap:14px}.learning-information>section{padding:14px}.timeframe-row,.classification-row{grid-template-columns:1fr;gap:9px}.timeframe-row>b br,.classification-row>b br{display:none}.experiment-summary>div{grid-template-columns:80px minmax(0,1fr)}}
